extends layout

block content
  h1 Registration Form
  p Enter your name and email address to register.

  if errors
    ul.errors
      each error in errors
        li= error.msg

  form(method='POST', action='/')
    label(for='name') Name
    input#name(type='text', name='name', value=data.name || '')

    label(for='email') Email
    input#email(type='email', name='email', value=data.email || '')

    button(type='submit') Submit
